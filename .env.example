# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.local

# --- PostgreSQL ---
POSTGRES_DB=bmstudvach
POSTGRES_USER=bmstudvach
POSTGRES_PASSWORD=bmstudvach
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Host port for the frontend dev server (change if 5173 is occupied).
FRONTEND_PORT=5173

# --- Platinum (LLM) ---
# Provider is abstracted; leave empty to use the fake generator.
PLATINUM_GENERATOR_PROVIDER=fake
# PLATINUM_LLM_API_KEY=
